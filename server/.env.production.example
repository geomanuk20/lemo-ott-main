# ==============================================================================
# LEMO OTT - Production Environment Configuration Template (Hostinger VPS)
# Copy this file to .env on your server: cp .env.production.example .env
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=5001

# MongoDB Atlas / Production Database Connection String
MONGODB_URI=mongodb+srv://<USER>:<PASSWORD>@cluster0.mongodb.net/lemo_ott?retryWrites=true&w=majority

# Redis Cache Server Configuration (Local Redis or Remote Cluster)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication Secret Key (Generate a long random 64-character hex key)
JWT_SECRET=lemo_ott_production_super_secret_jwt_key_2026_change_this_string

# AWS S3 & CloudFront Credentials (for Video HLS / Media Storage)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=lemo-ott-media-bucket
AWS_CLOUDFRONT_DOMAIN=https://d123456789.cloudfront.net
AWS_CLOUDFRONT_KEY_PAIR_ID=K1234567890ABC

# Cloudinary Backup Credentials (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP Mailer Settings (For Worker Background Emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@lemoott.com
SMTP_PASS=your_email_app_password
SMTP_FROM="LEMO OTT Platform" <no-reply@lemoott.com>

# PhonePe Payment Gateway Integration
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=PRODUCTION # PRODUCTION or UAT

# CORS Allowed Client Origins (Comma-separated)
CLIENT_URL=https://lemoott.com,https://www.lemoott.com
